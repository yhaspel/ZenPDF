# ZenPDF environment (01-architecture.md §19). Copy to .env (up.sh does this).

# --- Host ports (change if a port is taken on your machine) ---
API_PORT=8010
WEB_PORT=4200
DB_PORT=15432
MAILPIT_PORT=8025
STORAGE_PORT=8333

# --- Django ---
SECRET_KEY=dev-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=true
DATABASE_URL=postgres://zen:zen@db:5432/zenpdf
REDIS_URL=redis://redis:6379/0
FRONTEND_BASE_URL=http://localhost:4200
# Where the API answers from outside; emails link at it directly for a
# recipient's tokenized download. In dev the SPA proxies /api.
API_BASE_URL=http://localhost:4200

# --- Postgres container ---
POSTGRES_USER=zen
POSTGRES_PASSWORD=zen
POSTGRES_DB=zenpdf

# --- Storage (SeaweedFS S3) ---
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=zenpdf
S3_SECRET_KEY=zenpdf-secret-dev
S3_BUCKET=zenpdf
PRESIGNED_DELIVERY=false

# --- Email (Mailpit) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=ZenPDF <no-reply@zenpdf.local>

# --- Engine / signing ---
GOTENBERG_URL=http://gotenberg:3000
# Layer 2 of the SSRF guard — kept in step with apps/core/urlguard.py by
# test_urlguard.py::test_gotenberg_denies_what_layer_one_denies.
GOTENBERG_DENY_LIST=^file:(?!//\/tmp/).*|^[a-z]+://(?:[^/@]*@)?(localhost|127\.\d+(\.\d+)?(\.\d+)?|0\.0\.0\.0|0x[0-9a-f]+|0\d+(\.\d+)?(\.\d+)?(\.\d+)?|\d\d\d\d\d\d\d\d\d?\d?|\[?::1\]?|\[?::ffff:.*|\[?0:0:0:0:0:(0|ffff):.*|\[?fd[0-9a-f][0-9a-f]:.*|\[?fe80:.*|169\.254\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+|100\.100\.200\.200|metadata\.google\.internal|metadata\.goog|.*\.internal|api|web|db|redis|storage|mailpit|gotenberg|beat|worker-default|worker-heavy|worker-render)\.?([:/].*)?$$
SIGNING_CERT_PATH=/certs/zenpdf-dev.p12
SIGNING_CERT_PASSWORD=devpass
TSA_URL=
# Cap on the public /api/verify/ upload — smaller than a document upload
# because the endpoint is unauthenticated and nothing about checking a
# seal needs a large file.
VERIFY_MAX_UPLOAD_BYTES=31457280

# --- Limits (§16 — per-tier values live in settings.TIERS; these are "free") ---
MAX_UPLOAD_MB=100
# Per-file cap for *image* assets (custom stamps, watermarks, signatures — the
# `uploads/…` namespace, §13). Tier-resolved like every other limit; the stored
# object is metered against the storage quota.
MAX_IMAGE_UPLOAD_MB=10
USER_STORAGE_QUOTA_MB=2048
MAX_PAGES=2000
VERSION_RETENTION=50
SIGN_REQUESTS_PER_MONTH=30
OCR_PAGES_PER_MONTH=2000

# --- Anonymous access (§19, §21) ---
GUEST_ACCESS_ENABLED=true
GUEST_TTL_HOURS=24
GUEST_TTL_MAX_HOURS=72
GUEST_STORAGE_QUOTA_MB=200
GUEST_MAX_UPLOAD_MB=25
GUEST_MAX_IMAGE_UPLOAD_MB=5
GUEST_MAX_PAGES=300
CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Abuse-correlation salt only — never analytics. Rotate no *faster* than
# GUEST_TTL_MAX_HOURS, or the IP leg of the guest throttle key silently voids
# for in-flight sessions (§17).
GUEST_IP_HASH_SALT=dev-rotate-me

# --- Throttles (§16) ---
# 10/min/IP is the PRODUCTION value for the auth scope (register/login/refresh/
# logout share it). The full e2e suite drives 6 specs from a single IP and
# legitimately exceeds that in one minute, so the dev stack relaxes it. Prod
# does not set this and keeps the 10/min default. Phase 10 owns prod values.
THROTTLE_AUTH=60/min
# Same reasoning for the guest scope. §16's production value is 40/min,
# keyed on (guest_token, ip_hash) with the stricter winning — and the whole
# e2e suite runs many guest sessions from one IP, which is precisely the
# pattern the IP leg is designed to catch.
THROTTLE_GUEST=240/min
# Image uploads decode an untrusted file, so they carry their own scope *in
# addition to* the guest token/IP throttles.
THROTTLE_IMAGE_UPLOAD=60/hour

# --- Ads (phase 9) ---
ADS_ENABLED=false
ADSENSE_CLIENT_ID=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@zenpdf.local
SEED_ADMIN_PASSWORD=admin12345
