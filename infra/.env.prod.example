# ZenPDF prod environment — copy to .env.prod and fill in. Never commit .env.prod.
# config.settings.prod refuses to start without SECRET_KEY, which also signs JWTs.

# --- Django ---
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=false
ALLOWED_HOSTS=zenpdf.example.com
CORS_ALLOWED_ORIGINS=https://zenpdf.example.com
# Needed for the admin login form (it is the one CSRF-protected surface, and
# it sits behind a TLS-terminating proxy).
CSRF_TRUSTED_ORIGINS=https://zenpdf.example.com
FRONTEND_BASE_URL=https://zenpdf.example.com
# Every signing, verification and unsubscribe link is built from these two.
API_BASE_URL=https://zenpdf.example.com
DATABASE_URL=postgres://zen:CHANGE_ME@db:5432/zenpdf
REDIS_URL=redis://redis:6379/0
# Number of reverse proxies in front of gunicorn — the throttle client identity
# is taken this many hops from the right of X-Forwarded-For.
NUM_PROXIES=1

# --- Postgres container ---
POSTGRES_USER=zen
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zenpdf

# --- Storage (S3 / SeaweedFS) ---
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT=https://zenpdf.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zenpdf
PRESIGNED_DELIVERY=false

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ZenPDF <no-reply@zenpdf.example.com>

# --- Engine / signing ---
GOTENBERG_URL=http://gotenberg:3000
SIGNING_CERT_PATH=/certs/zenpdf.p12
SIGNING_CERT_PASSWORD=
TSA_URL=

# --- Limits (§16) ---
MAX_UPLOAD_MB=100
USER_STORAGE_QUOTA_MB=2048
MAX_PAGES=2000
SIGN_REQUESTS_PER_MONTH=30
OCR_PAGES_PER_MONTH=2000
MAX_CONCURRENT_JOBS=3

# --- Admin (§17) ---
# The moderation tools live here. An empty allowlist DENIES — forgetting to
# configure it must lock the door, not open it. Both the socket peer and the
# proxy-derived client must be listed, so behind a proxy list the proxy too.
ADMIN_ENABLED=false
ADMIN_URL_PATH=admin/
ADMIN_IP_ALLOWLIST=

# --- Observability (§10.4) — inert unless set ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_FORMAT=json

# --- Abuse contact (§9B) — printed in every mail footer ---
ABUSE_CONTACT_EMAIL=abuse@zenpdf.example.com

# --- Seed ---
# Leave empty in production. `seed_dev` is a development convenience and the
# launch checklist requires the seeded admin to be removed or rotated.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Transport ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=63072000
# A one-way door for the whole domain — opt in deliberately.
SECURE_HSTS_PRELOAD=false
